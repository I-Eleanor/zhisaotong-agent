# ---- LLM 配置 ----
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ---- Embedding 配置（二选一）----
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ---- 安全配置 ----
CORS_ORIGINS=*
API_TOKEN=

# ---- 人工转接工单（SQLite，标准库实现）----
# 数据库文件路径（必填，建议绝对路径）；未配置时工单接口返回 503
HANDOFF_DB_PATH=./data/handoffs.db
# 管理接口令牌（/api/admin/login 登录用，校验 ADMIN_TOKEN 后下发 HttpOnly 会话 Cookie）；留空表示禁用管理接口
ADMIN_TOKEN=
# 管理会话有效期（秒）；默认 8 小时（86400=1天）
# ADMIN_SESSION_TTL_SECONDS=28800

# ---- 本地模型路径（可选，仅本地开发时使用）----
# 填入本地已下载的模型路径，启动时将跳过 HF 在线下载
# 不填则使用 config/*.yml 中的 HF 模型名（Docker 部署时联网自动下载）
# LOCAL_EMBEDDING_PATH=
# LOCAL_RERANKER_PATH=

# ---- 可选 ----
# LLM_TIMEOUT_SECONDS=60
