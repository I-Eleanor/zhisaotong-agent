# ---- LLM 配置 ----
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ---- Embedding 配置（二选一）----
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ---- 安全配置 ----
CORS_ORIGINS=*
API_TOKEN=

# ---- 本地模型路径（可选，仅本地开发时使用）----
# 填入本地已下载的模型路径，启动时将跳过 HF 在线下载
# 不填则使用 config/*.yml 中的 HF 模型名（Docker 部署时联网自动下载）
# LOCAL_EMBEDDING_PATH=
# LOCAL_RERANKER_PATH=

# ---- 可选 ----
# LLM_TIMEOUT_SECONDS=60
